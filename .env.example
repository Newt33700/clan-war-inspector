# Cle API Supercell - https://developer.clashroyale.com
# La cle reste cote serveur : ne JAMAIS la prefixer NEXT_PUBLIC_.
CLASH_ROYALE_API_TOKEN=

# URL de base de l'API (optionnel, defaut: https://api.clashroyale.com/v1).
#
# L'API Supercell exige une liste d'IP fixes par cle. Sur un hebergeur a IP
# dynamique (Vercel, Netlify...), utilisez le proxy communautaire RoyaleAPI :
#   1. Creez une cle Supercell autorisant l'IP 45.79.218.79
#   2. Decommentez la ligne ci-dessous
# CLASH_ROYALE_API_BASE_URL=https://proxy.royaleapi.dev/v1
